# Korodexios core - environment overrides (the environment layer)
# Copy to ".env" and adjust. Precedence: CLI args > environment > kdx.local.yml >
# kdx.yml > defaults.
#
# Key mapping rules (case-insensitive):
#   1. strip a recognised prefix
#   2. split nesting on a DOUBLE underscore: "__"
#   3. lower-case each segment and map "-" to "_"
# Prefixes are consulted in this order, and the first match wins:
#   KDX_         primary short prefix        KDX_CORE__LOG__LEVEL=DEBUG  -> core.log.level
#   KORODEXIOS_  canonical long prefix       KORODEXIOS_CORE__LOG__LEVEL -> core.log.level
#
# Values stay strings; the chassis coerces them to the type each key declares.
KDX_CORE__LOG__LEVEL=INFO
KDX_CORE__LOG__FILE_ENABLED=true
KDX_CORE__LOG__JSON=false
KDX_CORE__MODULES__EXTRA_PATHS=
KDX_MODULES__HEARTBEAT__INTERVAL=2.0

# Control plane (IPC) overrides:
# KDX_CORE__IPC__HOST=0.0.0.0            LAN access; 127.0.0.1 keeps it local
# KDX_CORE__IPC__PORT=8123               0 asks the OS for a free port
# KDX_CORE__IPC__TOKEN=my-static-lan-key a secret clients can present remotely
# KDX_CORE__IPC__AUTH=false              anonymous /health and /api/v1/status
# KDX_CORE__IPC__ALLOW_ANONYMOUS_SHUTDOWN=true

# Discovery overrides (absolute paths recommended; KORODEXIOS_* works too):
# KDX_HOME=/srv/korodexios
# KDX_CONFIG=/etc/kdx/kdx.yml
# KDX_ENV_FILE=/etc/kdx/.env
