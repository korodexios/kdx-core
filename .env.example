# Korodexios core - environment overrides (layer 2 of 4)
# Copy to ".env" and adjust. Precedence: CLI args > environment > config file > defaults.
#
# Key mapping rules (case-insensitive):
#   1. strip the "KORODEX_" prefix
#   2. split nesting on a DOUBLE underscore: "__"
#   3. lower-case each segment and map "-" to "_"
#   KORODEX_CORE__LOG__LEVEL=DEBUG        ->  core.log.level
#   KORODEX_MODULES__HEARTBEAT__INTERVAL  ->  modules.heartbeat.interval
#
# Values stay strings; the chassis coerces them to the type each key declares.
KORODEX_CORE__LOG__LEVEL=INFO
KORODEX_CORE__LOG__FILE_ENABLED=true
KORODEX_CORE__LOG__JSON=false
KORODEX_CORE__MODULES__EXTRA_PATHS=
KORODEX_MODULES__HEARTBEAT__INTERVAL=2.0

# Control plane (IPC) overrides:
# KORODEX_CORE__IPC__HOST=0.0.0.0            LAN access; 127.0.0.1 keeps it local
# KORODEX_CORE__IPC__PORT=8123               0 asks the OS for a free port
# KORODEX_CORE__IPC__TOKEN=my-static-lan-key a secret clients can present remotely
# KORODEX_CORE__IPC__AUTH=false              anonymous /health and /api/v1/status
# KORODEX_CORE__IPC__ALLOW_ANONYMOUS_SHUTDOWN=true

# Discovery overrides (absolute paths recommended):
# KORODEX_HOME=/srv/korodexios
# KORODEX_CONFIG=/etc/korodex/korodex.yml
# KORODEX_ENV_FILE=/etc/korodex/.env
